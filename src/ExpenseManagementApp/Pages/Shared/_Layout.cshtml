<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Expense Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="container">
                <div class="navbar-brand">
                    <a href="/">💼 Expense Manager</a>
                </div>
                <ul class="nav-menu">
                    <li><a href="/" class="nav-link">Dashboard</a></li>
                    <li><a href="/Expenses" class="nav-link">Expenses</a></li>
                    <li><a href="/NewExpense" class="nav-link">New Expense</a></li>
                    <li><a href="/Approvals" class="nav-link">Approvals</a></li>
                    <li><a href="/swagger" class="nav-link" target="_blank">API Docs</a></li>
                </ul>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            <p>&copy; @DateTime.Now.Year - Expense Management System</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
